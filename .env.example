# Servidor
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa-com-no-minimo-32-caracteres

# SMTP obrigatório para enviar códigos reais de confirmação e recuperação
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@dominio.com
SMTP_PASS=sua-senha-de-app
MAIL_FROM="Veyronix <seu-email@dominio.com>"

# Banco SQLite (arquivo criado automaticamente)
DATABASE_PATH=./data/veyronix.sqlite

# Usuários que participaram da beta (separe usernames por vírgula, sempre minúsculos)
BETA_USERNAMES=

# Opcional, recomendado para chamadas estáveis entre redes diferentes (serviço TURN).
TURN_SERVER_URL=turn:seu-servidor:3478,turns:seu-servidor:5349
TURN_USERNAME=seu-usuario
TURN_CREDENTIAL=sua-senha
